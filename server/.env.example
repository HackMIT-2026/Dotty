# Copy to server/.env and fill in. The real .env is git ignored.
# These values are used only by the server. No client ever sees them.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dotty

# Leave blank to use the mock voice fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Comma separated origins allowed by CORS in local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080
