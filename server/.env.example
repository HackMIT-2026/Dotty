MONGO_URI=mongodb://localhost:27017
MONGO_DB=dotty
JWT_SECRET=change-me
# seconds between missed-treatment / sustained-high checks
ALERTS_TICK_SECONDS=60
# Carb estimates for typed foods. Without a key the server falls back to its food table and asks a parent.
ANTHROPIC_API_KEY=
# Which Claude model estimates carbs. Default claude-haiku-4-5 (the cheapest); claude-opus-5 judges harder ones better.
DOTTY_FOOD_MODEL=
